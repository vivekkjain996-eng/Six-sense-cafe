generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Status/role fields below are plain strings (not native Postgres enums)
// constrained to a fixed set of values at the application layer, so the
// schema stayed unchanged when this project moved from SQLite (no enum
// support) to Postgres:
//   AdminUser.role:            "OWNER" | "KITCHEN"
//   RestaurantTable.status:    "AVAILABLE" | "OCCUPIED"
//   TableSession.status:       "OPEN" | "CLOSED"
//   TableSession.paymentStatus:"UNPAID" | "PAID"
//   TableSession.paymentMethod:"CASH" | "CARD" | "ONLINE" (null until paid)
//   Order.status:              "PENDING" | "PREPARING" | "READY" | "SERVED" | "CANCELLED"

model Restaurant {
  id        String   @id @default(uuid())
  name      String
  address   String?
  phone     String?
  createdAt DateTime @default(now())

  adminUsers AdminUser[]
  tables     RestaurantTable[]
  categories Category[]
  menuItems  MenuItem[]
}

model AdminUser {
  id           String    @id @default(uuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])
  name         String
  email        String    @unique
  passwordHash String
  role         String    @default("OWNER")
  createdAt    DateTime  @default(now())
}

// Named RestaurantTable to avoid clashing with the reserved word "Table" in some tooling.
model RestaurantTable {
  id           String      @id @default(uuid())
  restaurantId String
  restaurant   Restaurant  @relation(fields: [restaurantId], references: [id])
  tableNumber  Int
  qrToken      String      @unique @default(uuid())
  status       String      @default("AVAILABLE")
  createdAt    DateTime    @default(now())

  sessions TableSession[]

  @@unique([restaurantId, tableNumber])
}

model Category {
  id           String     @id @default(uuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])
  name         String
  sortOrder    Int        @default(0)

  menuItems MenuItem[]
}

model MenuItem {
  id           String     @id @default(uuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])
  categoryId   String
  category     Category   @relation(fields: [categoryId], references: [id])
  name         String
  description  String?
  price        Float
  imageUrl     String?
  isVeg        Boolean    @default(true)
  isAvailable  Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  orderItems OrderItem[]
}

// The running bill for one seating at a table. Stays OPEN while the table
// keeps ordering; admin closes it once payment is settled.
model TableSession {
  id            String        @id @default(uuid())
  tableId       String
  table         RestaurantTable @relation(fields: [tableId], references: [id])
  status        String        @default("OPEN")
  paymentStatus String        @default("UNPAID")
  paymentMethod String?
  subtotal      Float         @default(0)
  tax           Float         @default(0)
  grandTotal    Float         @default(0)
  openedAt      DateTime      @default(now())
  closedAt      DateTime?

  orders Order[]
}

// One row per "place order" submission from the customer.
model Order {
  id             String      @id @default(uuid())
  tableSessionId String
  tableSession   TableSession @relation(fields: [tableSessionId], references: [id])
  status         String      @default("PENDING")
  placedAt       DateTime    @default(now())

  items OrderItem[]
}

model OrderItem {
  id               String   @id @default(uuid())
  orderId          String
  order            Order    @relation(fields: [orderId], references: [id])
  menuItemId       String
  menuItem         MenuItem @relation(fields: [menuItemId], references: [id])
  itemNameSnapshot String
  priceSnapshot    Float
  quantity         Int
  lineTotal        Float
}
